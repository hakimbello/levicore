{
  "name": "levi-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Levi desktop shell.",
  "author": "Hakim Bello",
  "license": "MIT",
  "homepage": "https://github.com/hakimbello/levicore#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/hakimbello/levicore.git"
  },
  "bugs": {
    "url": "https://github.com/hakimbello/levicore/issues"
  },
  "main": "dist-electron/electron/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && vite build && tsc -p electron/tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "test": "vitest run",
    "live:acceptance": "node scripts/live-acceptance.mjs",
    "lint": "npm run typecheck",
    "package": "npm run build && electron-builder --win nsis",
    "package:signed": "node scripts/validate-signing-env.mjs --required && npm run build && electron-builder --win nsis -c.forceCodeSigning=true",
    "package:publish": "npm run build && electron-builder --win nsis --publish always",
    "package:dir": "npm run build && electron-builder --win dir",
    "dist": "npm run package"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "electron-updater": "^6.8.9",
    "monaco-editor": "^0.52.2",
    "node-pty": "^1.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "37.10.3",
    "electron-builder": "^26.0.12",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.6",
    "vitest": "^3.2.4",
    "ws": "^8.21.1"
  },
  "build": {
    "appId": "dev.levicore.desktop",
    "productName": "Levi",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/node-pty/prebuilds/**"
    ],
    "extraFiles": [
      {
        "from": "../../src",
        "to": "src",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "hakimbello",
        "repo": "levicore",
        "releaseType": "draft"
      }
    ],
    "win": {
      "icon": "assets/levi.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
