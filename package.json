{
  "name": "levi-core",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "levi": "bin/levi.js"
  },
  "scripts": {
    "levi": "node bin/levi.js",
    "postinstall": "node packages/levi-desktop/scripts/ensure-electron-install.mjs",
    "test": "node --test test/*.test.js",
    "extension:check": "npm.cmd --prefix packages/vscode-extension run check",
    "extension:test": "npm.cmd --prefix packages/vscode-extension test",
    "extension:validate": "npm.cmd --prefix packages/vscode-extension run validate"
  }
}
